{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enableJsxInTemplate": true,
  "vue.server.hybridMode": true,
  "[vue]": {
    "editor.defaultFormatter": "Vue.volar"
  },
  "vetur.enabled": false,
  "vetur.validation.template": false,
  "vue.useLanguageServer": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "files.associations": {
    "*.vue": "vue"
  },
  "vue.volar.defaultFormatter": {
    "template": "prettier",
    "script": "prettier",
    "style": "prettier"
  },
  "vue.volar.takeOverMode": true,
  "vue.volar.completion.preferredMode": "auto",
  "vue.volar.formatting.enable": true
}